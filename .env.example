# GEMINI_API_KEY: Optional Gemini API key injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000 for AI Studio & Cloud Run)
PORT=3000

# ADMIN_EMAILS: Comma-separated list of verified admin email addresses
ADMIN_EMAILS=preethammk147@gmail.com

# Razorpay Payment Gateway (Test or Live credentials — server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
