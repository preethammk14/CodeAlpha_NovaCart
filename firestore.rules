rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOfferCode(code) {
      return code is string && code.size() >= 2 && code.size() <= 32 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'preethammk147@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerified() && isValidId(userId) && request.auth.uid == userId;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
        'id', 'title', 'brand', 'category', 'description',
        'price', 'originalPrice', 'discountPercent', 'rating',
        'reviewCount', 'stock', 'imageUrl', 'featured',
        'bestSeller', 'specialOffer', 'specs', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'title', 'brand', 'category', 'subCategory', 'description',
        'price', 'originalPrice', 'discountPercent', 'rating',
        'reviewCount', 'stock', 'imageUrl', 'gallery', 'featured',
        'bestSeller', 'specialOffer', 'isNew', 'createdOrder', 'specs',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
      && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 60
      && data.category is string && data.category in ['Electronics', 'Fashion', 'Home', 'Beauty', 'Accessories', 'Sports']
      && (!('subCategory' in data) || (data.subCategory is string && data.subCategory.size() >= 1 && data.subCategory.size() <= 60))
      && data.description is string && data.description.size() >= 10 && data.description.size() <= 1200
      && (data.price is int || data.price is float) && data.price > 0 && data.price <= 10000000
      && (data.originalPrice is int || data.originalPrice is float) && data.originalPrice >= data.price && data.originalPrice <= 10000000
      && data.discountPercent is int && data.discountPercent >= 0 && data.discountPercent <= 90
      && (data.rating is int || data.rating is float) && data.rating >= 0 && data.rating <= 5
      && data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 1000000
      && data.stock is int && data.stock >= 0 && data.stock <= 100000
      && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500
      && (!('gallery' in data) || (data.gallery is list && data.gallery.size() <= 6 && (data.gallery.size() == 0 || (data.gallery[0] is string && data.gallery[0].size() <= 500))))
      && data.featured is bool
      && data.bestSeller is bool
      && data.specialOffer is bool
      && (!('isNew' in data) || data.isNew is bool)
      && (!('createdOrder' in data) || (data.createdOrder is int && data.createdOrder >= 0 && data.createdOrder <= 100000))
      && data.specs is list && data.specs.size() <= 8
      && (data.specs.size() == 0 || (data.specs[0] is string && data.specs[0].size() <= 120))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidProductReview(data) {
      return data.keys().hasAll([
        'id', 'productId', 'userId', 'authorName', 'rating', 'title', 'comment', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'productId', 'userId', 'authorName', 'rating', 'title', 'comment', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.productId)
      && isValidId(data.userId)
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
      && data.rating is int && data.rating >= 1 && data.rating <= 5
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
      && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 800
      && data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
      && isValidId(data.uid)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
      && data.role is string && data.role in ['customer', 'admin']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'street', 'city', 'state', 'postalCode', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'email', 'phone', 'street', 'city', 'state', 'postalCode', 'updatedAt'])
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
      && data.phone is string && data.phone.size() <= 24
      && data.street is string && data.street.size() <= 240
      && data.city is string && data.city.size() <= 80
      && data.state is string && data.state.size() <= 80
      && data.postalCode is string && data.postalCode.size() <= 20
      && data.updatedAt is timestamp;
    }

    function isValidUserAddress(data) {
      return data.keys().hasAll([
        'id', 'label', 'recipientName', 'phone', 'street', 'city', 'state', 'postalCode', 'isDefault', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'label', 'recipientName', 'phone', 'street', 'city', 'state', 'postalCode', 'isDefault', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.label is string && data.label.size() >= 1 && data.label.size() <= 40
      && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 100
      && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 24
      && data.street is string && data.street.size() >= 3 && data.street.size() <= 240
      && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
      && data.state is string && data.state.size() >= 2 && data.state.size() <= 80
      && data.postalCode is string && data.postalCode.size() >= 4 && data.postalCode.size() <= 20
      && data.isDefault is bool
      && data.updatedAt is timestamp;
    }

    function isValidUserCart(data) {
      return data.keys().hasAll(['uid', 'items', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'items', 'updatedAt'])
      && isValidId(data.uid)
      && data.items is list && data.items.size() <= 50
      && (data.items.size() == 0 || (
        data.items[0] is map
        && data.items[0].keys().hasAll(['productId', 'quantity'])
        && data.items[0].keys().hasOnly(['productId', 'quantity'])
        && isValidId(data.items[0].productId)
        && data.items[0].quantity is int && data.items[0].quantity >= 1 && data.items[0].quantity <= 99
      ))
      && data.updatedAt is timestamp;
    }

    function isValidUserWishlist(data) {
      return data.keys().hasAll(['uid', 'productIds', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'productIds', 'updatedAt'])
      && isValidId(data.uid)
      && data.productIds is list && data.productIds.size() <= 100
      && (data.productIds.size() == 0 || isValidId(data.productIds[0]))
      && data.updatedAt is timestamp;
    }

    function isValidOrderAddress(addr) {
      return addr is map
      && addr.keys().hasAll(['street', 'city', 'state', 'postalCode'])
      && addr.keys().hasOnly(['street', 'city', 'state', 'postalCode'])
      && addr.street is string && addr.street.size() >= 3 && addr.street.size() <= 240
      && addr.city is string && addr.city.size() >= 2 && addr.city.size() <= 80
      && addr.state is string && addr.state.size() >= 2 && addr.state.size() <= 80
      && addr.postalCode is string && addr.postalCode.size() >= 4 && addr.postalCode.size() <= 20;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'id', 'orderNumber', 'userId', 'customerName', 'customerEmail',
        'customerPhone', 'shippingAddress', 'paymentMethod', 'items',
        'subtotal', 'shippingFee', 'discount', 'total', 'status',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'orderNumber', 'userId', 'customerName', 'customerEmail',
        'customerPhone', 'shippingAddress', 'paymentMethod', 'paymentStatus',
        'paymentGateway', 'razorpayOrderId', 'razorpayPaymentId',
        'estimatedDelivery', 'promoCode', 'items',
        'subtotal', 'shippingFee', 'discount', 'total', 'status',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32
      && isValidId(data.userId)
      && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
      && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 200
      && data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 24
      && isValidOrderAddress(data.shippingAddress)
      && data.paymentMethod is string && data.paymentMethod in ['cod', 'upi', 'gpay', 'phonepe', 'paytm', 'netbanking', 'debit_card', 'credit_card']
      && (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus in ['pay_on_delivery', 'paid', 'pending_verification', 'failed']))
      && (!('paymentGateway' in data) || (data.paymentGateway is string && data.paymentGateway in ['cod', 'razorpay']))
      && (!('razorpayOrderId' in data) || (data.razorpayOrderId is string && data.razorpayOrderId.size() <= 128))
      && (!('razorpayPaymentId' in data) || (data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 128))
      && (!('estimatedDelivery' in data) || (data.estimatedDelivery is string && data.estimatedDelivery.size() <= 80))
      && (!('promoCode' in data) || (data.promoCode is string && data.promoCode.size() <= 32))
      && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
      && data.items[0] is map
      && data.items[0].keys().hasAll(['productId', 'title', 'price', 'quantity', 'imageUrl'])
      && data.items[0].keys().hasOnly(['productId', 'title', 'price', 'quantity', 'imageUrl'])
      && isValidId(data.items[0].productId)
      && data.items[0].title is string && data.items[0].title.size() >= 1 && data.items[0].title.size() <= 140
      && (data.items[0].price is int || data.items[0].price is float) && data.items[0].price > 0
      && data.items[0].quantity is int && data.items[0].quantity >= 1 && data.items[0].quantity <= 99
      && data.items[0].imageUrl is string && data.items[0].imageUrl.size() <= 500
      && (data.subtotal is int || data.subtotal is float) && data.subtotal > 0
      && (data.shippingFee is int || data.shippingFee is float) && data.shippingFee >= 0
      && (data.discount is int || data.discount is float) && data.discount >= 0
      && (data.total is int || data.total is float) && data.total > 0
      && data.status is string && data.status in ['pending', 'confirmed', 'processing', 'shipped', 'out_for_delivery', 'delivered', 'cancelled']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['email', 'subscribedAt'])
      && data.keys().hasOnly(['email', 'subscribedAt'])
      && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
      && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
      && data.subscribedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'addedAt'])
      && data.keys().hasOnly(['uid', 'email', 'addedAt'])
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
      && data.addedAt is timestamp;
    }

    function isValidOffer(data) {
      return data.keys().hasAll([
        'id', 'code', 'title', 'description', 'discountType', 'discountValue',
        'maxDiscount', 'minOrderAmount', 'oneTimeUse', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'code', 'title', 'description', 'discountType', 'discountValue',
        'maxDiscount', 'minOrderAmount', 'oneTimeUse', 'status', 'expiresAt',
        'createdBy', 'createdAt', 'updatedAt'
      ])
      && isValidOfferCode(data.id)
      && isValidOfferCode(data.code)
      && data.id == data.code
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
      && data.description is string && data.description.size() >= 4 && data.description.size() <= 500
      && data.discountType is string && data.discountType in ['percentage', 'fixed', 'free_shipping']
      && (data.discountValue is int || data.discountValue is float) && data.discountValue >= 0 && data.discountValue <= 1000000
      && (data.maxDiscount is int || data.maxDiscount is float) && data.maxDiscount >= 0 && data.maxDiscount <= 1000000
      && (data.minOrderAmount is int || data.minOrderAmount is float) && data.minOrderAmount >= 0 && data.minOrderAmount <= 10000000
      && data.oneTimeUse is bool
      && data.status is string && data.status in ['Active', 'Expired', 'Cancelled']
      && (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 40))
      && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 200))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidOfferRedemption(data) {
      return data.keys().hasAll([
        'id', 'offerId', 'offerCode', 'offerTitle', 'discountType', 'discountValue',
        'discountApplied', 'userId', 'customerName', 'customerEmail',
        'orderId', 'orderNumber', 'orderTotal', 'status', 'redeemedAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'offerId', 'offerCode', 'offerTitle', 'discountType', 'discountValue',
        'discountApplied', 'userId', 'customerName', 'customerEmail',
        'orderId', 'orderNumber', 'orderTotal', 'status', 'redeemedAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidOfferCode(data.offerId)
      && data.offerCode is string && data.offerCode.size() >= 2 && data.offerCode.size() <= 32
      && data.offerTitle is string && data.offerTitle.size() >= 2 && data.offerTitle.size() <= 120
      && data.discountType is string && data.discountType in ['percentage', 'fixed', 'free_shipping']
      && (data.discountValue is int || data.discountValue is float) && data.discountValue >= 0 && data.discountValue <= 1000000
      && (data.discountApplied is int || data.discountApplied is float) && data.discountApplied >= 0 && data.discountApplied <= 1000000
      && isValidId(data.userId)
      && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
      && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 200
      && isValidId(data.orderId)
      && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32
      && (data.orderTotal is int || data.orderTotal is float) && data.orderTotal > 0
      && data.status is string && data.status in ['Redeemed', 'Cancelled']
      && data.redeemedAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
            && incoming().stock < existing().stock
            && incoming().stock >= 0
          )
        );
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /productReviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isVerified()
        && isValidId(reviewId)
        && isValidProductReview(incoming())
        && incoming().id == reviewId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerified() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().role == 'customer'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isVerifiedOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if (isOwner(userId) || isAdmin()) && docId == 'info';
        allow list: if false;
        allow create: if isOwner(userId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == userId
          && incoming().updatedAt == request.time;
        allow update: if (isVerifiedOwner(userId) || isAdmin())
          && docId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'street', 'city', 'state', 'postalCode', 'updatedAt']);
        allow delete: if (isVerifiedOwner(userId) || isAdmin()) && docId == 'info';
      }

      match /addresses/{addressId} {
        allow get, list: if isVerifiedOwner(userId) || isAdmin();
        allow create: if isVerifiedOwner(userId)
          && isValidId(addressId)
          && isValidUserAddress(incoming())
          && incoming().id == addressId
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedOwner(userId)
          && isValidId(addressId)
          && isValidUserAddress(incoming())
          && incoming().id == existing().id
          && incoming().updatedAt == request.time;
        allow delete: if isVerifiedOwner(userId) || isAdmin();
      }
    }

    match /carts/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidUserCart(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUserCart(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['items', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /wishlists/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidUserWishlist(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUserWishlist(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['productIds', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && ((isVerified() && existing().userId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && ((isVerified() && resource.data.userId == request.auth.uid) || isAdmin());
      allow create: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().paymentMethod == 'cod'
            && incoming().status == 'pending'
            && (!('paymentStatus' in incoming()) || incoming().paymentStatus == 'pay_on_delivery')
          )
          || (
            incoming().paymentMethod != 'cod'
            && incoming().status == 'confirmed'
            && 'paymentStatus' in incoming() && incoming().paymentStatus == 'paid'
            && 'razorpayOrderId' in incoming() && incoming().razorpayOrderId.size() >= 6
            && 'razorpayPaymentId' in incoming() && incoming().razorpayPaymentId.size() >= 6
          )
        );
      allow update: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && existing().status in ['pending', 'confirmed']
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /offers/{offerId} {
      allow get: if isValidOfferCode(offerId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidOfferCode(offerId)
        && isValidOffer(incoming())
        && incoming().id == offerId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidOfferCode(offerId)
        && isValidOffer(incoming())
        && incoming().id == existing().id
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidOfferCode(offerId);
    }

    match /offerRedemptions/{redemptionId} {
      allow get: if isSignedIn() && isValidId(redemptionId) && ((isVerified() && existing().userId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && ((isVerified() && resource.data.userId == request.auth.uid) || isAdmin());
      allow create: if isVerified()
        && isValidId(redemptionId)
        && isValidOfferRedemption(incoming())
        && incoming().id == redemptionId
        && incoming().userId == request.auth.uid
        && incoming().status == 'Redeemed'
        && incoming().redeemedAt == request.time
        && incoming().updatedAt == request.time
        && (
          !exists(/databases/$(database)/documents/offers/$(incoming().offerId))
          || get(/databases/$(database)/documents/offers/$(incoming().offerId)).data.oneTimeUse == false
          || redemptionId == (incoming().offerId + '__' + request.auth.uid)
        );
      allow update: if isVerified()
        && isValidId(redemptionId)
        && isValidOfferRedemption(incoming())
        && incoming().id == existing().id
        && incoming().offerId == existing().offerId
        && incoming().userId == existing().userId
        && incoming().orderId == existing().orderId
        && incoming().redeemedAt == existing().redeemedAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().userId == request.auth.uid
            && existing().status == 'Redeemed'
            && incoming().status == 'Cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(redemptionId);
    }

    match /newsletter/{subscriberId} {
      allow get: if isAdmin() && isValidId(subscriberId);
      allow list: if isAdmin();
      allow create: if isValidId(subscriberId)
        && isValidNewsletter(incoming())
        && incoming().subscribedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(subscriberId);
    }

    match /admins/{adminId} {
      allow get: if isBootstrappedAdmin() && isValidId(adminId);
      allow list: if isBootstrappedAdmin();
      allow create, update: if isBootstrappedAdmin()
        && isValidId(adminId)
        && isValidAdminRecord(incoming())
        && incoming().uid == adminId
        && incoming().addedAt == request.time;
      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }
  }
}
